# 복사해서 .env 로 쓴다. 모두 생략 가능(기본값 사용).

# DB(app.db)를 둘 폴더. Docker 에서는 /data 볼륨. 기본: 저장소의 data/
DATA_DIR=./data

# CORS 허용 출처(쉼표 구분). 관리자·방문객 프론트 주소를 넣는다.
CORS_ORIGINS=http://localhost:5173,https://nrbooth.team-cluster.kr,https://2026child.team-cluster.kr

# 세션 쿠키 Secure 속성. 1(기본)=HTTPS 에서만 전송, 0=로컬 HTTP 개발용.
SESSION_COOKIE_SECURE=1

# 앞단 프록시 단수(X-Forwarded-* 를 신뢰할 개수). Cloudflare(1)+리버스 프록시(1)=2, 직접 연결=0.
TRUSTED_PROXY_HOPS=2

# 오래된 보조 행(로그인 시도 기록 등) 정리 주기(초).
CLEANUP_INTERVAL=600
